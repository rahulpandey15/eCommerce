# Shared
ASPNETCORE_ENVIRONMENT=Production

# API container/listener
API_INTERNAL_PORT=8080
API_HOST_PORT=5285

# UI container/listener
UI_INTERNAL_PORT=8080
UI_HOST_PORT=5204

# API configuration (set secure values for real deployments)
API_CONNECTION_STRING=
JWT_SECRET=
JWT_ISSUER=eCommerceAPI
JWT_AUDIENCE=eCommerceUI

# Optional explicit UI -> API URL override.
# Default in compose is http://ecommerce-api:${API_INTERNAL_PORT}
UI_API_BASE_URL=

