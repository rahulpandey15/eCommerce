@using eCommerce.UI.Models.ViewModels
@model LoginViewModel


<h1>
   <form method="post">


    <div>
        <label>Email</label>
        <input type="text" asp-for="UserName" />
    </div>

    <div>
        <label>Password</label>
        <input type="text" type="password" asp-for="Password" />
    </div>


    <div>
        
      <button type="submit">Login</button>
    </div>
    </form>

</h1>